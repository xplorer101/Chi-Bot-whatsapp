# --- Core ---
ENV=dev
DEBUG=true
LOG_LEVEL=INFO
SESSION_SECRET=change-me
DATABASE_URL=postgresql+asyncpg://chibot:chibot@localhost:5432/chibot

# --- Anthropic ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Set true to use an offline deterministic stand-in for local dev / tests.
AI_MOCK=false
AI_MAX_TOKENS=400

# --- Meta WhatsApp Cloud API ---
GRAPH_API_BASE=https://graph.facebook.com/v22.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=choose-a-long-random-string
META_APP_SECRET=
# When true (or when ACCESS_TOKEN is empty) outbound messages are logged, not sent.
WHATSAPP_DRY_RUN=false